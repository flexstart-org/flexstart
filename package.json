{
  "name": "flexstart",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "flashds": "turbo dev --filter=flashds",
    "dash": "turbo dev --filter=dashboard",
    "shop": "turbo dev --filter=shop",
    "site": "turbo dev --filter=site",
    "trade": "turbo dev --filter=trade",
    "start": "turbo start",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@prisma/client": "^5.3.1",
    "postcss": "^8.4.29"
  },
  "devDependencies": {
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "eslint": "^8.47.0",
    "eslint-config-custom": "*",
    "next": "^13.4.19",
    "prettier": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.5.3",
    "prisma": "^5.3.1",
    "turbo": "^1.10.14"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18.x"
  }
}
