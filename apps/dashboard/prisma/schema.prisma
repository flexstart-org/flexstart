datasource db {
    provider     = "mongodb"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

model User {
    id                String    @id @default(uuid()) @map("_id")
    name              String?
    namespace         String?   @unique
    username          String?   @unique
    gh_username       String?
    email             String?   @unique
    emailVerified     DateTime?
    image             String?
    
    usage             Int       @default(0)
    usageLimit        Int       @default(1)
    plan              String    @default("free")
    stripeId          String? // @unique // Stripe subscription ID
    billingCycleStart Int? // day of the month when the billing cycle starts

    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    usageUpdatedAt    DateTime  @updatedAt

    accounts   Account[]
    sessions   Session[]
    secrets    Secret[]
    projects   ProjectUsers[]
    sentEmails SentEmail[]
}

model Account {
    id                       String  @id @default(uuid()) @map("_id")
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.String
    refresh_token_expires_in Int?
    access_token             String? @db.String
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.String
    session_state            String?
    oauth_token_secret       String?
    oauth_token              String?

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@unique([provider, providerAccountId])
    @@index([userId])
}

model Session {
    id           String   @id @default(uuid()) @map("_id")
    sessionToken String   @unique
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId       String

    @@index([userId])
}

model VerificationToken {
    id         String   @id @default(uuid()) @map("_id")
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Secret {
    id        String @id @default(uuid()) @map("_id")
    name      String
    namespace String
    user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String

    @@unique([name, namespace])
    @@index([userId])
}

model Project {
    id                String   @id @default(uuid()) @map("_id")
    namespace         String
    name              String
    replicas          Int      @default(1)
    image             String
    port              Int
    arch              String?
    secret            String?
    logo              String?
    domain            String   @unique
    domainVerified    Boolean  @default(false)
    domainLastChecked DateTime @default(now())
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    users              ProjectUsers[]
    invites            ProjectInvite[]
    usage              Int             @default(0)
    ownerUsageLimit    Int             @default(1)
    ownerExceededUsage Boolean         @default(false)
    sentEmails         SentEmail[]

    @@unique([name, namespace])
}

model ProjectUsers {
    id        String   @id @default(uuid()) @map("_id")
    role      String   @default("member")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId String

    @@unique([userId, projectId])
    @@index([projectId])
}

model ProjectInvite {
    id        String   @id @default(uuid()) @map("_id")
    email     String
    expires   DateTime
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId String
    createdAt DateTime @default(now())

    @@unique([email, projectId])
    @@index([projectId])
}

enum EmailType {
    firstDomainInvalidEmail
    secondDomainInvalidEmail
    firstUsageLimitEmail
    secondUsageLimitEmail
}

model SentEmail {
    id        String    @id @default(uuid()) @map("_id")
    type      EmailType
    createdAt DateTime  @default(now())
    user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String?
    project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId String?

    @@index([userId])
    @@index([projectId])
}
