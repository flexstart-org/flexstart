{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "trade#build": {
      "dependsOn": ["^build"],
      "env": ["App_ID", "Secret_ID", "Redirect_URL", "Auth_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "site#build": {
      "dependsOn": ["^build"],
      "env": [
        "EMAIL_SERVER",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "TWITTER_AUTH_TOKEN"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "shop#build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dashboard#build": {
      "dependsOn": ["^build"],
      "env": [
        "VERCEL",
        "VERCEL_URL",
        "NODE_ENV",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "DATABASE_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "EDGE_CONFIG",
        "EMAIL_SERVER",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "STRIPE_SECRET_KEY",
        "STRIPE_SECRET_KEY_LIVE",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE",
        "STRIPE_WEBHOOK_SECRET"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {},
    "lint": {},
    "check-types": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
