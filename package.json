{
  "name": "flexstart",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build#dash": "turbo build --filter=dashboard",
    "build#shop": "turbo build --filter=shop",
    "build#site": "turbo build --filter=site",
    "build#trade": "turbo build --filter=trade",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "dev#dash": "turbo dev --filter=dashboard",
    "dev#flashds": "turbo dev --filter=flashds",
    "dev#shop": "turbo dev --filter=shop",
    "dev#site": "turbo dev --filter=site",
    "dev#trade": "turbo dev --filter=trade",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo lint",
    "start": "turbo start"
  },
  "dependencies": {
    "@prisma/client": "^5.4.1",
    "postcss": "^8.4.31"
  },
  "devDependencies": {
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.10",
    "eslint": "^8.50.0",
    "eslint-config-custom": "0.0.0",
    "next": "^13.5.4",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.5",
    "prisma": "^5.4.1",
    "syncpack": "^11.2.1",
    "turbo": "^1.10.15"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18.x"
  }
}
