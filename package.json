{
  "name": "flexstart",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "clean": "turbo clean",
    "lint": "turbo lint",
    "dev#site": "turbo dev --filter=site",
    "dev#dash": "turbo dev --filter=dashboard",
    "dev#shop": "turbo dev --filter=shop",
    "dev#trade": "turbo dev --filter=trade",
    "dev#flashds": "turbo dev --filter=flashds",
    "build#site": "turbo build --filter=site",
    "build#dash": "turbo build --filter=dashboard",
    "build#shop": "turbo build --filter=shop",
    "build#trade": "turbo build --filter=trade",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@prisma/client": "6.0.0",
    "postcss": "8.5.2"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "eslint": "9.20.1",
    "eslint-config-custom": "0.0.0",
    "next": "15.1.7",
    "prettier": "3.5.1",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "6.0.0",
    "syncpack": "13.0.2",
    "turbo": "2.4.2"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.x"
  }
}
