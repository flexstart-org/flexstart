{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "site#build": {
      "dependsOn": ["^build"],
      "env": [
        "EMAIL_SERVER",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "TWITTER_AUTH_TOKEN"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "check-types": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
